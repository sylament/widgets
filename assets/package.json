{
  "name": "@sylament/widgets",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm clean && pnpm test:types && pnpm build:js",
    "build:js": "esbuild src/**/*.ts --outdir=dist --outbase=src --format=esm --sourcemap=linked",
    "watch": "pnpm watch:js",
    "watch:js": "esbuild src/**/*.ts --outdir=dist --outbase=src --format=esm --sourcemap=inline --watch=forever",
    "test:types": "tsc --noEmit"
  },
  "symfony": {
    "controllers": {
      "example": {
        "main": "dist/controllers/example_controller.js",
        "fetch": "lazy",
        "enabled": true
      }
    },
    "importmap": {
      "@hotwired/stimulus": "^3.0.0"
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.0.0"
  },
  "devDependencies": {
    "@hotwired/stimulus": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
